workspace "c4-live" {
  model {
    sys_c4_live = softwareSystem "c4-live" "Generated by c4-live" {
      c_c4_live = container "c4_live" "c4_live" "Python package" {
        m_c4_live___init = component "__init__" "c4_live/__init__.py" "Python module"
        m_c4_live___main = component "__main__" "c4_live/__main__.py" "Python module"
        m_c4_live_cli = component "cli" "c4_live/cli.py" "Python module"
        m_c4_live_diff = component "diff" "c4_live/diff.py" "Python module"
        m_c4_live_model = component "model" "c4_live/model.py" "Python module"
        m_c4_live_render = component "render" "c4_live/render.py" "Python module"
        m_c4_live_scan = component "scan" "c4_live/scan.py" "Python module"
      }
    }
    m_c4_live___main -> m_c4_live_cli "imports"
    m_c4_live_cli -> m_c4_live___init "imports"
    m_c4_live_cli -> m_c4_live_diff "imports"
    m_c4_live_cli -> m_c4_live_render "imports"
    m_c4_live_cli -> m_c4_live_scan "imports"
    m_c4_live_diff -> m_c4_live_model "imports"
    m_c4_live_diff -> m_c4_live_scan "imports"
    m_c4_live_render -> m_c4_live_model "imports"
    m_c4_live_scan -> m_c4_live_model "imports"
  }
  views {
    systemContext sys_c4_live "Context" {
      include *
      autolayout lr
    }
    container sys_c4_live "Containers" {
      include *
      autolayout lr
    }
    component c_c4_live "Components_c4_live" {
      include *
      autolayout lr
    }
    styles {
      element "External" {
        background #999999
        color #ffffff
      }
    }
  }
}
